ARGS
<!(--samples)samples>
<!(--index)index>
<(--aligner)aligner>
  hisat2
<!(--outdir/-o)outdir>
<(--threads/-t)threads>
  2
<(--rna-strandness)rna-strandness>
  none
<(--min-mapq)min-mapq>
  0
<(@:)fastp-pe-step>
<(@:)fastp-se-step>
<(@:)hisat2-align-pe-step>
<(@:)hisat2-align-se-step>
<(@:)samtools-sort-step>
<(@:)samtools-index-step>
<(@:)samtools-quickcheck-step>
<(@:)samtools-flagstat-step>
<(@:)samtools-idxstats-step>
<(@:)samtools-mapq-filter-step>
<(@:)samtools-mapq-index-step>
<(@:)multiqc-step>

RUN
<taffish>
set -eu

FLOW_NAME="rnaseq-alignment-flow"
FLOW_VERSION="0.2.0-r1"

samples_arg="::!(--samples)samples::"
index_arg="::!(--index)index::"
aligner="::aligner::"
outdir_arg="::!(--outdir/-o)outdir::"
threads="::threads::"
rna_strandness="::rna-strandness::"
min_mapq="::min-mapq::"
trim_arg="::(--trim)trim?::"
keep_sam_arg="::(--keep-sam)keep-sam?::"
force_arg="::(--force)force?::"

export read1 read2 out1 out2 html json threads index_prefix rna_strandness summary sam
export bam flagstat idxstats filtered min_mapq outdir reports_dir

flow_log=""

log() {
    printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >&2
    if [ -n "$flow_log" ]; then
        printf '%s [%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$FLOW_NAME" "$*" >> "$flow_log"
    fi
}

fail() {
    log "ERROR: $*"
    exit 1
}

sq() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

json_string() {
    printf '%s' "$1" | awk '
        BEGIN {
            ORS = ""
            bs = sprintf("%c", 92)
            dq = sprintf("%c", 34)
            tabc = sprintf("%c", 9)
            cr = sprintf("%c", 13)
            printf dq
        }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c == bs) {
                    printf "%s%s", bs, bs
                } else if (c == dq) {
                    printf "%s%s", bs, dq
                } else if (c == tabc) {
                    printf "%st", bs
                } else if (c == cr) {
                    printf "%sr", bs
                } else {
                    printf "%s", c
                }
            }
        }
        END {
            printf dq
        }
    '
}

resolve_path() {
    path_value=$1
    base_dir=$2
    case "$path_value" in
        /*) printf '%s\n' "$path_value" ;;
        *) printf '%s/%s\n' "$base_dir" "$path_value" ;;
    esac
}

is_true() {
    case "$1" in
        T|t|true|TRUE|True|1|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

is_positive_integer() {
    awk -v x="$1" 'BEGIN { exit !(x ~ /^[1-9][0-9]*$/) }'
}

is_nonnegative_integer() {
    awk -v x="$1" 'BEGIN { exit !(x ~ /^[0-9]+$/) }'
}

record_command() {
    step_name=$1
    cmd=$2
    printf '%s\n' "$cmd" >> "$commands_file"
}

resolve_hisat2_index() {
    raw=$1
    base=$2
    p=$(resolve_path "$raw" "$base")
    if [ -d "$p" ]; then
        candidates=$(find "$p" -maxdepth 1 \( -name '*.1.ht2' -o -name '*.1.ht2l' \) -print | sort)
        count=$(printf '%s\n' "$candidates" | awk 'NF { c++ } END { print c + 0 }')
        [ "$count" -eq 1 ] || fail "--index directory must contain exactly one HISAT2 prefix (*.1.ht2 or *.1.ht2l), found $count: $p"
        first=$(printf '%s\n' "$candidates" | awk 'NF { print; exit }')
        case "$first" in
            *.1.ht2) p=${first%.1.ht2} ;;
            *.1.ht2l) p=${first%.1.ht2l} ;;
        esac
    fi
    if [ -s "$p.1.ht2" ] || [ -s "$p.1.ht2l" ]; then
        printf '%s\n' "$p"
    else
        fail "HISAT2 index prefix not found. Expected $p.1.ht2 or $p.1.ht2l"
    fi
}

flagstat_value() {
    file=$1
    key=$2
    case "$key" in
        total)
            awk '/ in total / { print $1; found = 1; exit } END { if (!found) print 0 }' "$file"
            ;;
        mapped)
            awk '/ mapped \(/ && $0 !~ /primary mapped/ { print $1; found = 1; exit } END { if (!found) print 0 }' "$file"
            ;;
        pct)
            awk '/ mapped \(/ && $0 !~ /primary mapped/ {
                pct = $0
                sub(/^.*\(/, "", pct)
                sub(/%.*$/, "", pct)
                print pct
                found = 1
                exit
            } END { if (!found) print "0.00" }' "$file"
            ;;
    esac
}

start_cwd=$(pwd)
started_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

case "$aligner" in
    hisat2) : ;;
    star) fail "r1 supports --aligner hisat2 only; STAR support is planned for a later release" ;;
    *) fail "--aligner must be hisat2 in r1: $aligner" ;;
esac

is_positive_integer "$threads" || fail "--threads must be a positive integer: $threads"
is_nonnegative_integer "$min_mapq" || fail "--min-mapq must be a non-negative integer: $min_mapq"
case "$rna_strandness" in
    none|F|R|FR|RF) : ;;
    *) fail "--rna-strandness must be one of none, F, R, FR, RF: $rna_strandness" ;;
esac

samples_path=$(resolve_path "$samples_arg" "$start_cwd")
[ -s "$samples_path" ] || fail "--samples not found or empty: $samples_path"
samples_dir=$(CDPATH= cd "$(dirname "$samples_path")" && pwd)
index_prefix=$(resolve_hisat2_index "$index_arg" "$start_cwd")

outdir=$(resolve_path "$outdir_arg" "$start_cwd")
[ "$outdir" = "/" ] && fail "--outdir cannot be /"
[ "$outdir" = "$start_cwd" ] && fail "--outdir cannot be the current working directory"

if [ -e "$outdir" ]; then
    if is_true "$force_arg"; then
        rm -rf "$outdir/00_inputs" "$outdir/01_logs" "$outdir/02_intermediate" "$outdir/03_results" "$outdir/04_reports" "$outdir/run.manifest.json"
    else
        fail "--outdir already exists: $outdir (use --force to replace rnaseq-alignment-flow outputs)"
    fi
fi

inputs_dir="$outdir/00_inputs"
logs_dir="$outdir/01_logs"
logs_steps_dir="$logs_dir/steps"
intermediate_dir="$outdir/02_intermediate"
trimmed_dir="$intermediate_dir/trimmed"
sam_dir="$intermediate_dir/sam"
results_dir="$outdir/03_results"
bam_dir="$results_dir/bam"
fastp_dir="$results_dir/fastp"
aligner_logs_dir="$results_dir/aligner_logs"
reports_dir="$outdir/04_reports"

mkdir -p "$inputs_dir" "$logs_steps_dir" "$trimmed_dir" "$sam_dir" "$bam_dir" "$fastp_dir" "$aligner_logs_dir" "$reports_dir"

flow_log="$logs_dir/flow.log"
local_samples="$inputs_dir/samples.tsv"
alignment_inputs="$intermediate_dir/alignment_inputs.tsv"
alignment_summary_file="$results_dir/alignment_summary.tsv"
bam_files_file="$reports_dir/bam_files.tsv"
commands_file="$reports_dir/commands.sh"
versions_file="$reports_dir/versions.tsv"
methods_file="$reports_dir/methods.txt"
flow_summary_file="$reports_dir/flow_summary.tsv"
manifest_file="$outdir/run.manifest.json"

trim_flag=false
is_true "$trim_arg" && trim_flag=true
keep_sam_flag=false
is_true "$keep_sam_arg" && keep_sam_flag=true

{
    printf '#!/bin/sh\n'
    printf 'set -eu\n\n'
    printf '# Generated by %s %s at %s\n' "$FLOW_NAME" "$FLOW_VERSION" "$started_at"
    printf '# Re-run from a shell with the same input paths and TAFFISH dependency commands in PATH.\n\n'
} > "$commands_file"
chmod +x "$commands_file"

{
    printf 'tool\tversion\tsource\n'
    printf 'rnaseq-alignment-flow\t%s\ttaffish flow\n' "$FLOW_VERSION"
    printf 'taf-hisat2\t2.2.2-r2\ttaffish dependency\n'
    printf 'taf-samtools\t1.23.1-r1\ttaffish dependency\n'
    printf 'taf-fastp\t1.3.3-r3\ttaffish dependency\n'
    printf 'taf-multiqc\t1.35-r2\ttaffish dependency\n'
} > "$versions_file"

log "begin $FLOW_NAME $FLOW_VERSION"

log "START 01_validate_inputs"
if {
    awk -F '\t' -v OFS='\t' -v base="$samples_dir" -v out="$local_samples" '
        function trim(x) {
            gsub(/^[ \t\r]+/, "", x)
            gsub(/[ \t\r]+$/, "", x)
            return x
        }
        function abs_path(p) {
            p = trim(p)
            if (p == "") return ""
            if (p ~ /^\//) return p
            return base "/" p
        }
        function die(msg) {
            print "ERROR: samples.tsv: " msg > "/dev/stderr"
            exit 2
        }
        BEGIN {
            print "sample_id", "read1", "read2", "layout", "condition" > out
        }
        NR == 1 {
            for (i = 1; i <= NF; i++) col[$i] = i
            if (!("sample_id" in col)) die("missing sample_id column")
            if (!("read1" in col)) die("missing read1 column")
            has_read2 = ("read2" in col)
            has_condition = ("condition" in col)
            has_layout = ("library_layout" in col)
            next
        }
        /^[ \t\r]*$/ { next }
        {
            sid = trim($(col["sample_id"]))
            if (sid == "") die("empty sample_id on line " NR)
            if (sid !~ /^[A-Za-z0-9_.-]+$/) die("unsafe sample_id on line " NR ": " sid)
            if (seen[sid]++) die("duplicate sample_id: " sid)

            r1 = abs_path($(col["read1"]))
            r2 = ""
            if (has_read2) r2 = abs_path($(col["read2"]))
            layout = ""
            if (has_layout) layout = trim($(col["library_layout"]))
            if (layout == "") {
                layout = (r2 == "" ? "single-end" : "paired-end")
            }
            if (layout != "single-end" && layout != "paired-end") die("library_layout must be single-end or paired-end for " sid)
            if (layout == "paired-end" && r2 == "") die("paired-end sample missing read2: " sid)
            if (layout == "single-end" && r2 != "") die("single-end sample has read2: " sid)
            if (r2 == "") r2 = "."
            condition = ""
            if (has_condition) condition = trim($(col["condition"]))
            if (condition == "") condition = "."
            print sid, r1, r2, layout, condition > out
            count++
        }
        END {
            if (count == 0) die("contains no samples")
            print count + 0
        }
    ' "$samples_path" > "$intermediate_dir/sample_count.txt"

    sample_count=$(cat "$intermediate_dir/sample_count.txt")
    line_no=0
    while IFS="$(printf '\t')" read -r sid read1 read2 layout condition || [ -n "$sid" ]; do
        line_no=$((line_no + 1))
        [ "$line_no" -eq 1 ] && continue
        [ -s "$read1" ] || fail "read1 for $sid not found or empty: $read1"
        if [ "$layout" = "paired-end" ]; then
            [ -s "$read2" ] || fail "read2 for $sid not found or empty: $read2"
        fi
    done < "$local_samples"

    printf 'samples\t%s\n' "$sample_count"
    printf 'aligner\t%s\n' "$aligner"
    printf 'index_prefix\t%s\n' "$index_prefix"
    printf 'trim\t%s\n' "$trim_flag"
    printf 'threads\t%s\n' "$threads"
} > "$logs_steps_dir/01_validate_inputs.log" 2>&1; then
    sample_count=$(cat "$intermediate_dir/sample_count.txt")
    log "DONE  01_validate_inputs"
else
    log "FAIL  01_validate_inputs; see $logs_steps_dir/01_validate_inputs.log"
    exit 1
fi

log "START 02_fastp"
if {
    printf 'sample_id\tread1\tread2\tlayout\ttrimmed\n' > "$alignment_inputs"
    line_no=0
    while IFS="$(printf '\t')" read -r sid read1 read2 layout condition || [ -n "$sid" ]; do
        line_no=$((line_no + 1))
        [ "$line_no" -eq 1 ] && continue
        if [ "$trim_flag" = true ]; then
            html="$fastp_dir/$sid.fastp.html"
            json="$fastp_dir/$sid.fastp.json"
            if [ "$layout" = "paired-end" ]; then
                out1="$trimmed_dir/$sid.R1.fastq.gz"
                out2="$trimmed_dir/$sid.R2.fastq.gz"
                cmd="taf-fastp-v1.3.3-r3 fastp -i $(sq "$read1") -I $(sq "$read2") -o $(sq "$out1") -O $(sq "$out2") -h $(sq "$html") -j $(sq "$json") -w $(sq "$threads") ::(@:)fastp-pe-step::"
                record_command "02_fastp $sid" "$cmd"
                printf '\n$ %s\n' "$cmd"
                [[taf: taf-fastp-v1.3.3-r3 fastp -i '"$read1"' -I '"$read2"' -o '"$out1"' -O '"$out2"' -h '"$html"' -j '"$json"' -w '"$threads"' ::(@:)fastp-pe-step:: ]] </dev/null
                printf '%s\t%s\t%s\t%s\ttrue\n' "$sid" "$out1" "$out2" "$layout" >> "$alignment_inputs"
            else
                out1="$trimmed_dir/$sid.fastq.gz"
                cmd="taf-fastp-v1.3.3-r3 fastp -i $(sq "$read1") -o $(sq "$out1") -h $(sq "$html") -j $(sq "$json") -w $(sq "$threads") ::(@:)fastp-se-step::"
                record_command "02_fastp $sid" "$cmd"
                printf '\n$ %s\n' "$cmd"
                [[taf: taf-fastp-v1.3.3-r3 fastp -i '"$read1"' -o '"$out1"' -h '"$html"' -j '"$json"' -w '"$threads"' ::(@:)fastp-se-step:: ]] </dev/null
                printf '%s\t%s\t.\t%s\ttrue\n' "$sid" "$out1" "$layout" >> "$alignment_inputs"
            fi
        else
            printf 'trim skipped for %s\n' "$sid"
            printf '%s\t%s\t%s\t%s\tfalse\n' "$sid" "$read1" "$read2" "$layout" >> "$alignment_inputs"
        fi
    done < "$local_samples"
} >> "$logs_steps_dir/02_fastp.log" 2>&1; then
    log "DONE  02_fastp"
else
    log "FAIL  02_fastp; see $logs_steps_dir/02_fastp.log"
    exit 1
fi

log "START 03_align"
if {
    line_no=0
    while IFS="$(printf '\t')" read -r sid read1 read2 layout trimmed || [ -n "$sid" ]; do
        line_no=$((line_no + 1))
        [ "$line_no" -eq 1 ] && continue
        sam="$sam_dir/$sid.sam"
        summary="$aligner_logs_dir/$sid.hisat2.summary.txt"
        strand_args=""
        if [ "$rna_strandness" != "none" ]; then
            strand_args=" --rna-strandness $(sq "$rna_strandness")"
        fi
        if [ "$layout" = "paired-end" ]; then
            cmd="taf-hisat2-v2.2.2-r2 hisat2 -x $(sq "$index_prefix") -p $(sq "$threads")$strand_args --summary-file $(sq "$summary") -1 $(sq "$read1") -2 $(sq "$read2") -S $(sq "$sam") ::(@:)hisat2-align-pe-step::"
            record_command "03_align $sid" "$cmd"
            printf '\n$ %s\n' "$cmd"
            if [ "$rna_strandness" = "none" ]; then
                [[taf: taf-hisat2-v2.2.2-r2 hisat2 -x '"$index_prefix"' -p '"$threads"' --summary-file '"$summary"' -1 '"$read1"' -2 '"$read2"' -S '"$sam"' ::(@:)hisat2-align-pe-step:: ]] </dev/null
            else
                [[taf: taf-hisat2-v2.2.2-r2 hisat2 -x '"$index_prefix"' -p '"$threads"' --rna-strandness '"$rna_strandness"' --summary-file '"$summary"' -1 '"$read1"' -2 '"$read2"' -S '"$sam"' ::(@:)hisat2-align-pe-step:: ]] </dev/null
            fi
        else
            cmd="taf-hisat2-v2.2.2-r2 hisat2 -x $(sq "$index_prefix") -p $(sq "$threads")$strand_args --summary-file $(sq "$summary") -U $(sq "$read1") -S $(sq "$sam") ::(@:)hisat2-align-se-step::"
            record_command "03_align $sid" "$cmd"
            printf '\n$ %s\n' "$cmd"
            if [ "$rna_strandness" = "none" ]; then
                [[taf: taf-hisat2-v2.2.2-r2 hisat2 -x '"$index_prefix"' -p '"$threads"' --summary-file '"$summary"' -U '"$read1"' -S '"$sam"' ::(@:)hisat2-align-se-step:: ]] </dev/null
            else
                [[taf: taf-hisat2-v2.2.2-r2 hisat2 -x '"$index_prefix"' -p '"$threads"' --rna-strandness '"$rna_strandness"' --summary-file '"$summary"' -U '"$read1"' -S '"$sam"' ::(@:)hisat2-align-se-step:: ]] </dev/null
            fi
        fi
        [ -s "$sam" ] || fail "alignment SAM missing for $sid: $sam"
    done < "$alignment_inputs"
} >> "$logs_steps_dir/03_align.log" 2>&1; then
    log "DONE  03_align"
else
    log "FAIL  03_align; see $logs_steps_dir/03_align.log"
    exit 1
fi

log "START 04_sort_index"
if {
    printf 'sample_id\tbam\tbai\n' > "$bam_files_file"
    printf 'sample_id\tlayout\ttrimmed\ttotal_reads\tmapped_reads\tmapped_percent\tbam\tbai\thisat2_summary\tflagstat\n' > "$alignment_summary_file"
    line_no=0
    total_reads_all=0
    mapped_reads_all=0
    while IFS="$(printf '\t')" read -r sid read1 read2 layout trimmed || [ -n "$sid" ]; do
        line_no=$((line_no + 1))
        [ "$line_no" -eq 1 ] && continue
        sam="$sam_dir/$sid.sam"
        bam="$bam_dir/$sid.sorted.bam"
        bai="$bam.bai"
        flagstat="$aligner_logs_dir/$sid.flagstat.txt"
        idxstats="$aligner_logs_dir/$sid.idxstats.tsv"
        summary="$aligner_logs_dir/$sid.hisat2.summary.txt"

        cmd="taf-samtools-v1.23.1-r1 samtools sort -@ $(sq "$threads") -o $(sq "$bam") ::(@:)samtools-sort-step:: $(sq "$sam")"
        record_command "04_sort_index sort $sid" "$cmd"
        printf '\n$ %s\n' "$cmd"
        [[taf: taf-samtools-v1.23.1-r1 samtools sort -@ '"$threads"' -o '"$bam"' ::(@:)samtools-sort-step:: '"$sam"' ]] </dev/null
        cmd="taf-samtools-v1.23.1-r1 samtools index -@ $(sq "$threads") ::(@:)samtools-index-step:: $(sq "$bam")"
        record_command "04_sort_index index $sid" "$cmd"
        printf '\n$ %s\n' "$cmd"
        [[taf: taf-samtools-v1.23.1-r1 samtools index -@ '"$threads"' ::(@:)samtools-index-step:: '"$bam"' ]] </dev/null
        cmd="taf-samtools-v1.23.1-r1 samtools quickcheck ::(@:)samtools-quickcheck-step:: $(sq "$bam")"
        record_command "04_sort_index quickcheck $sid" "$cmd"
        printf '\n$ %s\n' "$cmd"
        [[taf: taf-samtools-v1.23.1-r1 samtools quickcheck ::(@:)samtools-quickcheck-step:: '"$bam"' ]] </dev/null
        cmd="taf-samtools-v1.23.1-r1 samtools flagstat -@ $(sq "$threads") ::(@:)samtools-flagstat-step:: $(sq "$bam") > $(sq "$flagstat")"
        record_command "04_sort_index flagstat $sid" "$cmd"
        printf '\n$ %s\n' "$cmd"
        [[taf: taf-samtools-v1.23.1-r1 samtools flagstat -@ '"$threads"' ::(@:)samtools-flagstat-step:: '"$bam"' ]] </dev/null > "$flagstat"
        cmd="taf-samtools-v1.23.1-r1 samtools idxstats ::(@:)samtools-idxstats-step:: $(sq "$bam") > $(sq "$idxstats")"
        record_command "04_sort_index idxstats $sid" "$cmd"
        printf '\n$ %s\n' "$cmd"
        [[taf: taf-samtools-v1.23.1-r1 samtools idxstats ::(@:)samtools-idxstats-step:: '"$bam"' ]] </dev/null > "$idxstats"
        if [ "$min_mapq" -gt 0 ]; then
            filtered="$bam_dir/$sid.mapq${min_mapq}.sorted.bam"
            filtered_bai="$filtered.bai"
            cmd="taf-samtools-v1.23.1-r1 samtools view -@ $(sq "$threads") -b -q $(sq "$min_mapq") -o $(sq "$filtered") ::(@:)samtools-mapq-filter-step:: $(sq "$bam")"
            record_command "04_sort_index mapq $sid" "$cmd"
            printf '\n$ %s\n' "$cmd"
            [[taf: taf-samtools-v1.23.1-r1 samtools view -@ '"$threads"' -b -q '"$min_mapq"' -o '"$filtered"' ::(@:)samtools-mapq-filter-step:: '"$bam"' ]] </dev/null
            mv "$filtered" "$bam"
            cmd="taf-samtools-v1.23.1-r1 samtools index -@ $(sq "$threads") ::(@:)samtools-mapq-index-step:: $(sq "$bam")"
            record_command "04_sort_index mapq-index $sid" "$cmd"
            printf '\n$ %s\n' "$cmd"
            [[taf: taf-samtools-v1.23.1-r1 samtools index -@ '"$threads"' ::(@:)samtools-mapq-index-step:: '"$bam"' ]] </dev/null
            [ -e "$filtered_bai" ] && rm -f "$filtered_bai"
        fi
        if [ "$keep_sam_flag" != true ]; then
            rm -f "$sam"
        fi

        total_reads=$(flagstat_value "$flagstat" total)
        mapped_reads=$(flagstat_value "$flagstat" mapped)
        mapped_percent=$(flagstat_value "$flagstat" pct)
        total_reads_all=$((total_reads_all + total_reads))
        mapped_reads_all=$((mapped_reads_all + mapped_reads))
        printf '%s\t%s\t%s\n' "$sid" "$bam" "$bai" >> "$bam_files_file"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sid" "$layout" "$trimmed" "$total_reads" "$mapped_reads" "$mapped_percent" "$bam" "$bai" "$summary" "$flagstat" >> "$alignment_summary_file"
    done < "$alignment_inputs"
    printf '%s\n' "$total_reads_all" > "$intermediate_dir/total_reads.txt"
    printf '%s\n' "$mapped_reads_all" > "$intermediate_dir/mapped_reads.txt"
} >> "$logs_steps_dir/04_sort_index.log" 2>&1; then
    total_reads_all=$(cat "$intermediate_dir/total_reads.txt")
    mapped_reads_all=$(cat "$intermediate_dir/mapped_reads.txt")
    log "DONE  04_sort_index"
else
    log "FAIL  04_sort_index; see $logs_steps_dir/04_sort_index.log"
    exit 1
fi

log "START 05_multiqc"
if {
cmd="taf-multiqc-v1.35-r2 multiqc $(sq "$outdir") --outdir $(sq "$reports_dir") --filename multiqc_report.html --data-format json --force --quiet ::(@:)multiqc-step::"
    record_command "05_multiqc" "$cmd"
    printf '\n$ %s\n' "$cmd"
    [[taf: taf-multiqc-v1.35-r2 multiqc '"$outdir"' --outdir '"$reports_dir"' --filename multiqc_report.html --data-format json --force --quiet ::(@:)multiqc-step:: ]] </dev/null
    [ -s "$reports_dir/multiqc_report.html" ] || fail "MultiQC report missing: $reports_dir/multiqc_report.html"
} >> "$logs_steps_dir/05_multiqc.log" 2>&1; then
    log "DONE  05_multiqc"
else
    log "FAIL  05_multiqc; see $logs_steps_dir/05_multiqc.log"
    exit 1
fi

mapped_percent_all=$(awk -v mapped="$mapped_reads_all" -v total="$total_reads_all" 'BEGIN { if (total > 0) printf "%.2f", mapped * 100 / total; else printf "0.00" }')

{
    printf 'metric\tvalue\n'
    printf 'flow\t%s\n' "$FLOW_NAME"
    printf 'version\t%s\n' "$FLOW_VERSION"
    printf 'sample_count\t%s\n' "$sample_count"
    printf 'aligner\t%s\n' "$aligner"
    printf 'trim\t%s\n' "$trim_flag"
    printf 'threads\t%s\n' "$threads"
    printf 'rna_strandness\t%s\n' "$rna_strandness"
    printf 'min_mapq\t%s\n' "$min_mapq"
    printf 'keep_sam\t%s\n' "$keep_sam_flag"
    printf 'total_reads\t%s\n' "$total_reads_all"
    printf 'mapped_reads\t%s\n' "$mapped_reads_all"
    printf 'mapped_percent\t%s\n' "$mapped_percent_all"
} > "$flow_summary_file"

{
    printf 'rnaseq-alignment-flow %s aligned RNA-seq FASTQ samples to a user-supplied HISAT2 genome index and produced coordinate-sorted BAM files. ' "$FLOW_VERSION"
    if [ "$trim_flag" = true ]; then
        printf 'Reads were preprocessed with fastp before alignment. '
    else
        printf 'Reads were aligned without fastp preprocessing. '
    fi
    printf 'SAM files were sorted and indexed with SAMtools; per-sample flagstat and idxstats summaries were written for downstream QC. '
    printf 'The flow records commands, dependency versions, methods, logs, BAM paths, and a machine-readable manifest. '
    printf 'r1 supports HISAT2; STAR, featureCounts, and RSeQC/Qualimap are intentionally left to later or downstream flows.\n'
} > "$methods_file"

finished_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
{
    printf '{\n'
    printf '  "flow": "rnaseq-alignment-flow",\n'
    printf '  "version": %s,\n' "$(json_string "$FLOW_VERSION")"
    printf '  "started_at": %s,\n' "$(json_string "$started_at")"
    printf '  "finished_at": %s,\n' "$(json_string "$finished_at")"
    printf '  "inputs": {\n'
    printf '    "samples": %s,\n' "$(json_string "$samples_path")"
    printf '    "index": %s\n' "$(json_string "$index_prefix")"
    printf '  },\n'
    printf '  "parameters": {\n'
    printf '    "aligner": %s,\n' "$(json_string "$aligner")"
    printf '    "threads": %s,\n' "$threads"
    printf '    "trim": %s,\n' "$trim_flag"
    printf '    "rna_strandness": %s,\n' "$(json_string "$rna_strandness")"
    printf '    "min_mapq": %s,\n' "$min_mapq"
    printf '    "keep_sam": %s\n' "$keep_sam_flag"
    printf '  },\n'
    printf '  "dependencies": {\n'
    printf '    "taf-hisat2": "2.2.2-r2",\n'
    printf '    "taf-samtools": "1.23.1-r1",\n'
    printf '    "taf-fastp": "1.3.3-r3",\n'
    printf '    "taf-multiqc": "1.35-r2"\n'
    printf '  },\n'
    printf '  "counts": {\n'
    printf '    "sample_count": %s,\n' "$sample_count"
    printf '    "total_reads": %s,\n' "$total_reads_all"
    printf '    "mapped_reads": %s,\n' "$mapped_reads_all"
    printf '    "mapped_percent": %s\n' "$mapped_percent_all"
    printf '  },\n'
    printf '  "outputs": {\n'
    printf '    "bam_files": %s,\n' "$(json_string "$bam_files_file")"
    printf '    "alignment_summary": %s,\n' "$(json_string "$alignment_summary_file")"
    printf '    "multiqc_report": %s,\n' "$(json_string "$reports_dir/multiqc_report.html")"
    printf '    "flow_summary": %s\n' "$(json_string "$flow_summary_file")"
    printf '  }\n'
    printf '}\n'
} > "$manifest_file"

log "completed. BAM files: $bam_dir"
log "reports: $reports_dir"
